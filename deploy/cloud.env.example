# Server only. Copy to /etc/three-kingdoms/cloud.env with permissions 0600.
TK_PUBLIC_ORIGIN=https://game.example.com
TK_HOST=127.0.0.1
PORT=3080
TK_WEB_DIR=build/web-online
TK_DATA_DIR=/var/lib/three-kingdoms
TK_DB_NAMESPACE=three-kingdoms
SUPABASE_URL=https://YOUR_GAME_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Direct connection or SESSION pool on 5432, never transaction pool on 6543.
# Percent-encode special characters in the password. TLS verification is required.
DATABASE_URL=postgresql://GAME_SERVER:REPLACE_ME@YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full
# Optional: project-specific trusted CA certificate downloaded from its dashboard.
# NODE_EXTRA_CA_CERTS=/etc/three-kingdoms/database-ca.crt
TK_ALLOWED_EMAILS=player@example.com,friend@example.com
TK_MAX_ROOMS=32
TK_MAX_ROOMS_PER_ACCOUNT=4
