[Unit]
Description=Three Kingdoms authoritative room server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=three-kingdoms
Group=three-kingdoms
WorkingDirectory=/opt/three-kingdoms
EnvironmentFile=/etc/three-kingdoms/cloud.env
ExecStart=/usr/bin/node scripts/start-cloud.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=three-kingdoms
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/three-kingdoms
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
